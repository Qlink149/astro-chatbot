# =============================================================================
# Samara dashboard (Vite) — Frontend env template
# Copy to frontend/.env (local) or set in Vercel → Environment Variables
# (Root Directory = frontend)
#
# VITE_* vars are baked in at BUILD time. Redeploy after changing them.
# =============================================================================

# Backend base URL — MUST match how the API is mounted:
#
#   Vercel Python (api/index.py):  https://YOUR-API.vercel.app
#                                  ↑ NO trailing slash, NO /api prefix
#
#   Emergent / server.py gateway:  https://YOUR-HOST/api
#                                  ↑ HAS /api prefix
#
VITE_API_URL=https://YOUR-API.vercel.app

# Legacy CRA-style (optional; not used by current Vite dashboard)
# REACT_APP_BACKEND_URL=https://YOUR-HOST
# WDS_SOCKET_PORT=443
# ENABLE_HEALTH_CHECK=false
