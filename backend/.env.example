# =============================================================================
# Samara / Clara — Backend env template
# Copy to backend/.env and fill real values. NEVER commit .env
#
# Vercel: set these in Project → Settings → Environment Variables
# (Root Directory = backend)
#
# Path note:
#   Vercel (api/index.py):  https://YOUR-API.vercel.app/api/...   ← /api prefix
#   Emergent (server.py):   https://YOUR-HOST/.../api/...     ← HAS /api
# =============================================================================

ENV_MODE=dev
DEFAULT_CLIENT_ID=samara
MONGO_URI=mongodb+srv://USER:PASS@CLUSTER.mongodb.net/
MONGO_DB_NAME=astro_chatbot
CHAT_HISTORY_MAX_LENGTH=50

SUPER_ADMIN_USERNAME=admin
SUPER_ADMIN_PASSWORD=change-me-strong-password
JWT_SECRET_KEY=change-me-long-random-string
SYSTEM_API_KEY=change-me-long-random-api-key

AI_PROVIDER=openai
AI_PROVIDER_CLASSIFIER=openai
AI_PROVIDER_GENERAL=openai
AI_FALLBACK_ENABLED=false
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_API_KEY=

ANTHROPIC_API_KEY=
ANTHROPIC_CHAT_MODEL=claude-haiku-4-5

GROQ_API_KEY=

GUPSHUP_APP_NAME=
GUPSHUP_APP_ID=
GUPSHUP_TOKEN=
GUPSHUP_API_KEY=
GUPSHUP_SOURCE=
GUPSHUP_PHONE_NUMBER=
GUPSHUP_WEBHOOK_SECRET=

SAMARA_PHONE_NUMBER_ID=
SAMARA_BIRTH_FLOW_ID=

WEBHOOK_URL=https://YOUR-API.vercel.app/api/gupshup/message/samara
GUPSHUP_WEBHOOK_TAG=samara-chatbot
GUPSHUP_WEBHOOK_VERSION=3
GUPSHUP_WEBHOOK_MODES=MESSAGE,FLOWS_MESSAGE,SENT,DELIVERED,READ,DELETED,FAILED,OTHERS,ENQUEUED
GUPSHUP_WEBHOOK_SHOW_ON_UI=true

GUPSHUP_PARTNER_EMAIL=
GUPSHUP_PARTNER_CLIENT_SECRET=

GUPSHUP_FLOW_NAME=samara_birth_details
GUPSHUP_FLOW_CATEGORIES=OTHER
GUPSHUP_FLOW_JSON_PATH=json/birth_details.json

LOG_LEVEL=INFO
LOG_HTTP_BODIES=true
KB_ENABLED=false

# Razorpay (payment links + webhook). Amount for WhatsApp exact "PAY" test trigger.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
SAMARA_TEST_PAYMENT_AMOUNT_INR=1
# Webhook URL to register in Razorpay Dashboard:
#   https://YOUR-API.vercel.app/razorpay/webhook
# Create link (auth JWT or SYSTEM_API_KEY):
#   curl -X POST https://YOUR-API.vercel.app/system/payments/create-payment-link \
#     -H "Authorization: Bearer <token>" -H "Content-Type: application/json" \
#     -d '{"order_id":"samara_test_1","amount_in_rupees":49,"currency":"INR","customer":{"name":"Test","contact":"919999999999"}}'
